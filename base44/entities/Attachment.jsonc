{
  "properties": {
    "keep_id": {
      "type": "string",
      "description": "The Keep this attachment belongs to"
    },
    "circle_id": {
      "type": "string",
      "description": "The Circle this Keep belongs to"
    },
    "attachment_type": {
      "type": "string",
      "description": "Type of media",
      "enum": [
        "audio",
        "image"
      ]
    },
    "file_uri": {
      "type": "string",
      "description": "Private file URI for signed URL generation"
    },
    "file_url": {
      "type": "string",
      "description": "Public file URL if applicable"
    },
    "duration": {
      "type": "number",
      "description": "Audio duration in seconds"
    },
    "file_size": {
      "type": "number",
      "description": "File size in bytes"
    },
    "mime_type": {
      "type": "string",
      "description": "MIME type of the file"
    },
    "circle_member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Denormalized member IDs for RLS"
    }
  },
  "required": [
    "keep_id",
    "circle_id",
    "attachment_type",
    "file_uri"
  ],
  "rls": {
    "read": {
      "data.circle_member_ids": "{{user.id}}"
    },
    "create": {
      "data.circle_member_ids": {
        "$in": [
          "{{user.id}}"
        ]
      }
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  },
  "name": "Attachment",
  "type": "object"
}